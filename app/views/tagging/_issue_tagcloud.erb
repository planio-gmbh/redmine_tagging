<a id="cloud_trigger"><b><%= @project ? t(:tags_in_project) : t(:tags) %></b></a>
<span id="cloud_content"> &mdash;
  <% RedmineTagging::Tagcloud.tag_cloud_in_project(@project) do |tag, factor| %>
    <a class="tag_item"
       data-tag="<%= j tag.sub /^#/, '' %>"
       style="<%= "font-size: #{10 * factor + 9}pt" %>"><%= tag %></a> 
  <% end %>
</span>
