<h3><%= l(:field_tags) %></h3>

<div id='tagcloud'>
  <%
    RedmineTagging::Tagcloud.new.tag_cloud_in_project(@project) do |tag, factor|
      options = {}
      if RedmineTagging.dynamic_font_size?
        options[:style] = "font-size: #{10 * factor + 9}pt"
      end
  %>
      <%= link_to_project_tag_filter(@project, tag, {}, options) %>
  <% end %>
</div>
