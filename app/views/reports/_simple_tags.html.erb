<% if @statuses.empty? or rows.empty? %>
    <p><i><%=l(:label_no_data)%></i></p>
<% else %>
<table class="list">
<thead><tr>
<th style="width:25%"></th>
<th align="center" style="width:25%"><%=l(:label_open_issues_plural)%></th>
<th align="center" style="width:25%"><%=l(:label_closed_issues_plural)%></th>
<th align="center" style="width:25%"><%=l(:label_total)%></th>
</tr></thead>
<tbody>
<% for tag in rows %>
<tr class="<%= cycle("odd", "even") %>">
  <td>
    <%= link_to tag.name, project_issues_path(@project, RedmineTagging::Tagcloud.tag_filter_link_options(tag.name)) %>
  </td>
  <td align="center">
    <%= link_to aggregate(data, { field_name => tag.id, "closed" => 0 }),
                project_issues_path(@project, RedmineTagging::Tagcloud.tag_filter_link_options(tag.name))
    %>
  </td>
  <td align="center">
    <%= link_to aggregate(data, { field_name => tag.id, "closed" => 1 }),
                project_issues_path(@project, RedmineTagging::Tagcloud.tag_filter_link_options(tag.name, status: 'c'))
    %>
  </td>
  <td align="center">
    <%= link_to aggregate(data, { field_name => tag.id }),
                project_issues_path(@project, RedmineTagging::Tagcloud.tag_filter_link_options(tag.name, status: '*'))
    %>
  </td>
</tr>
<% end %>
</tbody>
</table>
<% end
  reset_cycle %>
